mainmenu "Wi-Fi MQTT TLS application"

config WIFI_SAMPLE_SSID
	string "SSID of the target AP"
	default "CHANGE_ME_WIFI_SSID"
	help
	  SSID of the access point to connect to in station mode.
	  For example: "TARGET-AP"

config WIFI_SAMPLE_PSK
	string "Pre-shared key for target AP"
	default "CHANGE_ME_WIFI_PSK"
	help
	  WPA2 password used to connect to the target AP.
	  For example: "PSK"

config WIFI_SAMPLE_DHCPV4_START
	bool "Start DHCPv4 server in application layer."
	default y
	help
	  Enable this option to start the DHCPv4 server from the application layer,
	  typically before the Soft AP is initialized.

	  When disabled, the DHCPv4 server startup timing is determined by the vendor's
	  implementation. In some cases, the server may be started after the AP is up,
	  using the vendor's default IP address, gateway, subnet mask.

config MQTT_BROKER_ADDRESS
	string "MQTT broker IPv4 address"
	default "CHANGE_ME_BROKER_IP"
	help
	  IPv4 address of the local Mosquitto broker.

config MQTT_CLIENT_ID
	string "MQTT client ID"
	default "esp32c6-wifi-tls"

config MQTT_TOPIC
	string "MQTT test topic (unused)"
	default "iot/test"
	help
	  Not used since the firmware publishes Sparkplug B topics (see SPARKPLUG_*).
	  Kept so existing wifi-local.conf files that set it still build.

menu "Sparkplug B"

config SPARKPLUG_GROUP_ID
	string "Sparkplug group ID"
	default "gruppe_4"
	help
	  <group_id> in spBv1.0/<group_id>/<message type>/<edge_node_id>[/<device_id>].

config SPARKPLUG_EDGE_NODE_ID
	string "Sparkplug edge node ID"
	default "c6-01"
	help
	  This ESP32-C6. The broker ACL should only let it write its own topics.

config SPARKPLUG_DEVICE_ID
	string "Sparkplug device ID of the Modbus slave"
	default "wroom_01"
	help
	  The Modbus RTU slave read by this node; it gets DBIRTH, DDATA and DDEATH.

config SPARKPLUG_PRIMARY_HOST_ID
	string "Sparkplug primary host application ID"
	default "red_01"
	help
	  The node subscribes to spBv1.0/STATE/<id> and only publishes NBIRTH while the host
	  reports {"online": true}. When it reports offline, the node sends NDEATH and
	  reconnects. Leave empty to publish without waiting for a host.

config SPARKPLUG_SAMPLE_INTERVAL_S
	int "Seconds between Modbus samples at boot"
	default 10
	range 1 3600
	help
	  Published as Config/SampleInterval_s; an NCMD can change it at runtime.

config SPARKPLUG_BATCH_SIZE
	int "Samples per DDATA message"
	default 3
	range 1 12
	help
	  Samples are collected and sent together, each with its own timestamp, to save data.
	  A sample reaches the broker up to SAMPLE_INTERVAL_S * BATCH_SIZE seconds late.

endmenu

config MQTT_SNTP_SERVER
	string "SNTP server name or IPv4 address"
	default "pool.ntp.org"
	help
	  Server asked for the time before TLS. A name needs a DNS server; an IPv4 address does not.

config NETWORK_CELLULAR
	bool "Use the Stamp CatM modem (PPP) instead of Wi-Fi"
	default n
	help
	  Selects the modem network layer (src/network_modem.c) in CMakeLists.txt instead of Wi-Fi (src/network_wifi.c). Wi-Fi remains the default.

config NETWORK_IPV4_TIMEOUT_SECONDS
	int "Seconds to wait for an IPv4 address"
	default 30

source "Kconfig.zephyr"
